<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           xmlns="http://javafx.com/javafx"
           fx:id="root"
           fx:controller="Operaciones.venta.controller.MainController"
           stylesheets="@/Operaciones/venta/style/estilos.css">

    <BorderPane fx:id="mainLayout">
        <center>
            <SplitPane dividerPositions="0.03">
                <VBox fx:id="contenedor" styleClass="contenedor">
                    <VBox styleClass="opciones">
                        <HBox fx:id="rootHBox" spacing="0" alignment="CENTER_LEFT">
                            <CheckBox fx:id="miCheckBox" text="Seleccionar todo" styleClass="custom-check">
                                <HBox.margin>
                                    <Insets left="25"/>
                                </HBox.margin>
                            </CheckBox>
                            <Button fx:id="btnEliminar" styleClass="botones" onMouseClicked="#eliminarSeleccionados">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/eliminar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets left="30"/>
                                </HBox.margin>
                            </Button>
                            <Label fx:id="lblEliminar" text="Eliminar" styleClass="labels">
                                <HBox.margin>
                                    <Insets left="10"/>
                                </HBox.margin>
                            </Label>

                            <Region fx:id="expansor"/>
                            <Button styleClass="botones" onMouseClicked="#abrirNuevoCliente">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/agregar1.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets right="10"/>
                                </HBox.margin>
                            </Button>
                            <Label fx:id="lblCliente" text="Cliente:" styleClass="labels"/>
                            <ComboBox fx:id="buscador"
                                      editable="true"
                                      styleClass="barraBusqueda combo-sin-flecha">
                                <HBox.margin>
                                    <Insets left="10"/>
                                </HBox.margin>
                            </ComboBox>

                            <Button styleClass="botones"  onMouseClicked="#abrirFormularioVenta">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/agregar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets left="30"/>
                                </HBox.margin>
                            </Button>
                            <Label fx:id="lblAgregar" text="Agregar" styleClass="labels">
                                <HBox.margin>
                                    <Insets  top="0" right="40" bottom="0" left="10"/>
                                </HBox.margin>
                            </Label>
                        </HBox>

                        <HBox fx:id="segundaFila" spacing="0" alignment="CENTER_RIGHT">
                            <Label fx:id="lblFactura" text="No Factura:" styleClass="labels">
                                <HBox.margin>
                                    <Insets right="10"/>
                                </HBox.margin>
                            </Label>
                            <TextField fx:id="factura" styleClass="factura" >
                                <HBox.margin>
                                    <Insets right="40"/>
                                </HBox.margin>
                            </TextField>
                        </HBox>
                    </VBox>

                    <!-- TABLA -->
                    <VBox fx:id="contenedorTabla" styleClass="tabla" alignment="CENTER">
                        <padding>
                            <Insets left="40" right="40"/>
                        </padding>
                        <TableView fx:id="contenidoTabla" styleClass="contenidoTable">
                            <!-- Encabezados de la tabla -->
                            <columns>
                                <TableColumn fx:id="colSelect" prefWidth="70" />
                                <TableColumn fx:id="colClaveProduct" text="ID producto" prefWidth="120" />
                                <TableColumn fx:id="colProducto" text="Producto" prefWidth="200" />
                                <TableColumn fx:id="colDescripcionProducto" text="Descripcion" prefWidth="290" />
                                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="120" />
                                <TableColumn fx:id="colLote" text="Lote" prefWidth="120"/>
                                <TableColumn fx:id="colCaducidad" text="Caducidad" prefWidth="150" />
                                <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="150" />
                                <TableColumn fx:id="colNota" text="Nota" prefWidth="360" />
                                <TableColumn fx:id="colPrecioUnitario" text="Precio unitario" prefWidth="150" />
                                <TableColumn fx:id="colPrecioIva" text="Precio con IVA" prefWidth="150" />
                                <TableColumn fx:id="colPrecioBruto" text="Precio bruto" prefWidth="150" />
                                <TableColumn fx:id="colPrecioTotaal" text="Precio total" prefWidth="170" />
                            </columns>
                        </TableView>

                        <!-- TOTAL PEGADO A LA TABLA -->
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblTotal" text="Total:" styleClass="labels">
                                <HBox.margin>
                                    <Insets right="10"/>
                                </HBox.margin>
                            </Label>
                            <TextField fx:id="totalVenta"
                                       editable="false"
                                       styleClass="factura"
                                       promptText="Total">
                            </TextField>
                        </HBox>
                    </VBox>
                    <HBox fx:id="contenedorComentario" spacing="8" alignment="CENTER_LEFT">
                        <!-- margen izquierdo / derecho lo aplicas al HBox si lo quieres -->
                        <Label fx:id="lblComentario" text="Comentario:" styleClass="labels">
                            <HBox.margin>
                                <Insets left="40"/>
                            </HBox.margin>
                        </Label>
                        <TextField fx:id="comentario" HBox.hgrow="ALWAYS" prefHeight="35">
                            <HBox.margin>
                                <Insets right="25" left="8"/>
                            </HBox.margin>
                        </TextField>
                        <HBox fx:id="contenedorBtnConfirmar" alignment="CENTER_RIGHT">
                            <Button fx:id="botonConfirmar" styleClass="botonConfirmar" text="Confirmar">
                                <HBox.margin>
                                    <Insets right="40"/>
                                </HBox.margin>
                            </Button>
                        </HBox>
                    </HBox>
                </VBox>
            </SplitPane>
        </center>
    </BorderPane>
</StackPane>
