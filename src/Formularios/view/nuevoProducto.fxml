<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="Formularios.controller.controllerNuevoProducto"
            prefWidth="700" prefHeight="550"
            style="-fx-background-color: white; -fx-padding: 20;"
            stylesheets="@/Formularios/style/estilos.css">

    <top>
        <Label text="Producto" style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <content>
                <VBox spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20;">

                    <!-- Sección de imagen -->
                    <HBox spacing="20" alignment="TOP_LEFT">
                        <VBox spacing="10" alignment="CENTER">
                            <Label text="Imagen del producto:" style="-fx-font-weight: bold;"/>
                            <ImageView fx:id="imageView" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@/img/vacio.png"/>
                                </image>
                            </ImageView>
                            <Button fx:id="btnSeleccionarImagen" text="Seleccionar Imagen"
                                    onAction="#seleccionarImagen" prefWidth="150"/>
                        </VBox>

                        <VBox spacing="15" HBox.hgrow="ALWAYS">

                            <HBox spacing="10">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="ID Producto *"/>
                                    <TextField fx:id="txtIdProducto" prefWidth="150"/>
                                </VBox>

                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Nombre *"/>
                                    <TextField fx:id="txtNombre" prefWidth="250"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10">

                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Categoría"/>
                                    <!-- ComboBox NO editable (solo elegir) -->
                                    <ComboBox fx:id="cmbCategoria" prefWidth="150" editable="false"/>
                                </VBox>

                                <!-- ETIQUETA: ComboBox editable -->
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Etiqueta"/>
                                    <ComboBox fx:id="cmbEtiqueta" prefWidth="150" editable="true"/>
                                </VBox>

                                <!-- MARCA: ComboBox editable -->
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Marca"/>
                                    <ComboBox fx:id="cmbMarca" prefWidth="200" editable="true"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Material"/>
                                    <TextField fx:id="txtMaterial" prefWidth="200"/>
                                </VBox>

                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <VBox fx:id="contenedorUnidadMedida" spacing="5"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Inventario Mínimo"/>
                                    <TextField fx:id="txtInventarioMin" prefWidth="150"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Descripción:"/>
                        <TextArea fx:id="txtDescripcion" prefHeight="100" wrapText="true"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button text="Guardar" fx:id="btnGuardar" styleClass="boton" onAction="#guardarProducto"
                    prefWidth="100"/>
        </HBox>
    </bottom>
</BorderPane>
