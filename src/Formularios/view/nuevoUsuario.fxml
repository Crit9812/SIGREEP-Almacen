<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            prefWidth="400" prefHeight="400"
            style="-fx-background-color: white; -fx-padding: 20;"
            stylesheets="@/Formularios/style/estilos.css"
            fx:controller="Formularios.controller.controllerNuevoUsuario">


    <!-- Título -->
    <top>
        <Label fx:id="titulo" text="Agregar usuario"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Contenido principal -->
    <center>
        <VBox spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20;">
            <HBox>
                <HBox spacing="10">
                    <VBox spacing="5">
                        <Label text="Nombre de usuario:"/>
                        <TextField fx:id="txtNombreDeUsuario" prefWidth="300" maxWidth="380"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Rol:"/>
                        <ComboBox fx:id="miComboBox" prefWidth="180" styleClass="comboBx"/>
                    </VBox>
                </HBox>
            </HBox>

            <HBox>
                <VBox spacing="5">
                    <Label text="Nombre:"/>
                    <TextField fx:id="txtNombre" prefWidth="380" maxWidth="380"/>
                </VBox>
            </HBox>

            <HBox>
                <VBox spacing="5">
                    <Label text="Apellido paterno:"/>
                    <TextField fx:id="txtApellidoPaterno" prefWidth="380" maxWidth="380"/>
                </VBox>
            </HBox>

            <HBox>
                <VBox spacing="5">
                    <Label text="Apellido materno:"/>
                    <TextField fx:id="txtApellidoMaterno" prefWidth="380" maxWidth="380"/>
                </VBox>
            </HBox>

            <!-- Contraseña -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="5">
                    <Label text="Contraseña:"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <StackPane>
                            <PasswordField fx:id="txtContrasena" prefWidth="260"/>
                            <TextField fx:id="txtContrasenaVisible" prefWidth="260" visible="false" managed="false"/>
                        </StackPane>
                        <Button fx:id="btnVerContrasena" text="👁" prefWidth="40"
                                alignment="CENTER"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Confirmar contraseña -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="5">
                    <Label text="Confirmar contraseña:"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <StackPane>
                            <PasswordField fx:id="txtConfirmarContrasena" prefWidth="260"/>
                            <TextField fx:id="txtConfirmarContrasenaVisible" prefWidth="260" visible="false" managed="false"/>
                        </StackPane>
                        <Button fx:id="btnVerConfirmar" text="👁" prefWidth="40"
                                alignment="CENTER"/>
                    </HBox>
                </VBox>
            </HBox>

        </VBox>
    </center>

    <!-- Botones -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button text="Guardar" fx:id="btnGuardar" styleClass="boton"/>
        </HBox>
    </bottom>


</BorderPane>
