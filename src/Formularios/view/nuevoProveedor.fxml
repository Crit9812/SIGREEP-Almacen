<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.cotm/javafx"
            prefWidth="700" prefHeight="430"
            style="-fx-background-color: white; -fx-padding: 20;"
            stylesheets="@/Formularios/style/estilos.css">

    <top>
        <Label fx:id="titulo" text="Actualizar proveedor"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20;">

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="Nombre:"/>
                    <TextField fx:id="txtNombre" prefWidth="250"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Representante:"/>
                    <TextField fx:id="txtRepresentante" prefWidth="250"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="RFC:"/>
                    <TextField fx:id="txtRFC" prefWidth="250"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="CURP:"/>
                    <TextField fx:id="txtCURP" prefWidth="250"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Razón social:"/>
                <TextField fx:id="txtRazonSocial" prefWidth="530"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="C.P:"/>
                    <TextField fx:id="txtCP" prefWidth="100"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="País:"/>
                    <TextField fx:id="txtPais" prefWidth="130"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Estado:"/>
                    <TextField fx:id="txtEstado" prefWidth="130"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Localidad:"/>
                    <TextField fx:id="txtLocalidad" prefWidth="130"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="Ciudad:"/>
                    <TextField fx:id="txtCiudad" prefWidth="200"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Colonia:"/>
                    <ComboBox fx:id="cmbColonia" editable="true" prefWidth="200"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="Domicilio:"/>
                    <TextField fx:id="txtDomicilio" prefWidth="200"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="No ext:"/>
                    <TextField fx:id="txtNoExt" prefWidth="70"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="No int:"/>
                    <TextField fx:id="txtNoInt" prefWidth="70"/>
                </VBox>
            </HBox>

            <HBox spacing="20">
                <VBox spacing="5">
                    <Label text="Correo electrónico:"/>
                    <TextField fx:id="txtCorreo" prefWidth="200"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Teléfono:"/>
                    <TextField fx:id="txtTelefono" prefWidth="200"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button text="Actualizar" fx:id="btnGuardar" styleClass="boton" onAction="#guardarProveedor"/>
        </HBox>
    </bottom>
</BorderPane>
