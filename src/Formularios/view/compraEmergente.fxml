<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            prefWidth="500" prefHeight="700"
            style="-fx-background-color: white; -fx-padding: 20;"
            stylesheets="@/Formularios/style/estilos.css">

    <!-- Título -->
    <top>
        <Label fx:id="lblTitulo" text="Compra"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Contenido principal con scroll -->
    <center>
        <ScrollPane fitToWidth="true"
                    vbarPolicy="AS_NEEDED"
                    hbarPolicy="NEVER"
                    style="-fx-background: white; -fx-background-color: white;">
            <content>
                <VBox spacing="15"
                      alignment="TOP_LEFT"
                      style="-fx-padding: 20; -fx-background-color: white;">

                    <!-- Ingresar producto -->
                    <HBox spacing="20">
                        <!-- Recuadro de imagen estático -->
                        <StackPane fx:id="contenedorImagen" prefWidth="180" prefHeight="190"
                                   minWidth="180" minHeight="190"
                                   maxWidth="180" maxHeight="190"
                                   style="-fx-border-color: #bbb; -fx-border-width: 2;">
                            <ImageView fx:id="previewImage" fitWidth="170" fitHeight="180" preserveRatio="true"/>
                        </StackPane>

                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="Ingresar producto por:"/>
                            <VBox spacing="5">
                                <Label text="Clave producto:"/>
                                <HBox spacing="10">
                                    <VBox>
                                        <Pane VBox.vgrow="ALWAYS"/>
                                        <HBox alignment="CENTER" spacing="20">
                                            <Button text="+" fx:id="btnNuevoProducto"
                                                    onAction="#agregarProducto"
                                                    styleClass="botonAgregarUbi"/>
                                        </HBox>
                                    </VBox>
                                    <ComboBox fx:id="cbClaveProducto" prefWidth="180" maxWidth="180"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Clave alterna:"/>
                                <HBox spacing="10">
                                    <VBox>
                                        <Pane VBox.vgrow="ALWAYS"/>
                                        <HBox alignment="CENTER" spacing="20">
                                            <Button text="+" fx:id="btnVincularProducto"
                                                    onAction="#vincularProducto"
                                                    styleClass="botonAgregarUbi"/>
                                        </HBox>
                                    </VBox>
                                    <ComboBox fx:id="cbClaveAlterna" prefWidth="180" maxWidth="180"/>
                                </HBox>
                            </VBox>


                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Producto:"/>
                                <ComboBox fx:id="cbProductoNombre" prefWidth="210" maxWidth="210"/>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Descripción -->
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Descripción:"/>
                            <TextField fx:id="txtDescripcion" style="-fx-min-height: 40;"/>
                        </VBox>
                    </HBox>

                    <!-- Lote, Caducidad, Cantidad -->
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Lote:"/>
                            <TextField fx:id="txtLote"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Caducidad:"/>
                            <DatePicker fx:id="dpCaducidad" promptText="Selecciona fecha"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Cantidad:"/>
                            <TextField fx:id="txtCantidad"/>
                        </VBox>
                    </HBox>

                    <!-- Presentación y Factor -->
                    <HBox alignment="CENTER_RIGHT" spacing="20">
                        <VBox spacing="5">
                            <Label text="Presentación:"/>
                            <ComboBox fx:id="cbPresentacion" prefWidth="110" maxWidth="110"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Factor:"/>
                            <TextField fx:id="txtFactor" prefWidth="80" maxWidth="80"/>
                        </VBox>
                    </HBox>

                    <!-- Ubicaciones dinámicas -->
                    <HBox spacing="20">
                        <VBox fx:id="contenedorUbicaciones" spacing="10"/>
                    </HBox>

                    <!-- Subtitulo -->
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Nota:"/>
                            <TextField fx:id="txtNota" style="-fx-min-height: 40;"/>
                        </VBox>
                    </HBox>

                    <!-- Precios -->
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Precio entrada:"/>
                            <TextField fx:id="txtPrecioEntrada"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="IVA:" prefWidth="30" minWidth="30"/>
                            <CheckBox fx:id="checkBoxIVA"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Precio con IVA:"/>
                            <TextField fx:id="txtPrecioIVA"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Precio bruto:"/>
                            <TextField fx:id="txtPrecioBruto" prefWidth="150" maxWidth="150"/>
                        </VBox>
                    </HBox>

                    <!-- Precio total -->
                    <HBox alignment="CENTER_RIGHT" spacing="20">
                        <VBox spacing="5">
                            <Label text="Precio total:"/>
                            <TextField fx:id="txtPrecioTotal" prefWidth="150" maxWidth="150"/>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Botón Guardar -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button text="Limpiar" fx:id="btnLimpiar" styleClass="boton"/>
            <Button text="Guardar" fx:id="btnGuardar" styleClass="boton"/>
        </HBox>
    </bottom>
</BorderPane>
