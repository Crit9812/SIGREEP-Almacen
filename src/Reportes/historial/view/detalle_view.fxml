<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="Reportes.historial.controller.DetalleFacturaController"
           prefWidth="500" prefHeight="680"
           style="-fx-background-color: white;"
           stylesheets="@/Reportes/historial/style/estilos.css">

    <BorderPane style="-fx-background-color: white;">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 15 20;">
                <Label fx:id="lblTitulo"
                       text="Detalles"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkDetallado" text="Vista Detallada"
                          style="-fx-text-fill: #34495e; -fx-font-size: 13px;"/>
            </HBox>
        </top>
        <center>
            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;">
                <content>
                    <VBox fx:id="contenedorDetalles"
                          spacing="12"
                          alignment="TOP_LEFT"
                          style="-fx-padding: 20; -fx-background-color: white;"/>
                </content>
            </ScrollPane>
        </center>
        <bottom>
            <HBox alignment="CENTER_RIGHT" spacing="25" style="-fx-background-color: white;">
                <padding>
                    <Insets top="10" bottom="20" right="40"/>
                </padding>
                <Button fx:id="btnDescargar" text="Descargar" onAction="#descargarReporte" styleClass="boton"/>
                <Button fx:id="btnCancelarEntrada" text="Cancelar entrada" onAction="#cancelarEntrada" styleClass="botonCancelar"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelarMovimiento" styleClass="botonCancelar"/>
            </HBox>
        </bottom>
    </BorderPane>

    <fx:include fx:id="overlayPane" source="/Compartido/view/label.fxml"/>
</StackPane>
