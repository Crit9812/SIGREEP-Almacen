<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           xmlns="http://javafx.com/javafx"
           fx:id="root"
           fx:controller="Consultas.clasificacion.controller.MainController"
           stylesheets="@/Consultas/clasificacion/style/estilos.css">

    <BorderPane fx:id="mainLayout">

        <center>
            <SplitPane dividerPositions="0.03">
                <VBox fx:id="contenedor" styleClass="contenedor" VBox.vgrow="ALWAYS">
                    <VBox styleClass="opciones">
                        <HBox fx:id="rootHBox" spacing="0" alignment="CENTER_LEFT">
                            <Button fx:id="btnAgregarMarca" styleClass="botones" onAction="#agregarMarca">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/agregar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets left="25"/>
                                </HBox.margin>
                            </Button>
                            <Label text="Agregar marca" styleClass="labels">
                                <HBox.margin>
                                    <Insets left="10"/>
                                </HBox.margin>
                            </Label>
                            <Button fx:id="btnAgregarEtiqueta" styleClass="botones" onAction="#agregarEtiqueta">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/agregar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets left="30"/>
                                </HBox.margin>
                            </Button>
                            <Label text="Agregar etiqueta" styleClass="labels">
                                <HBox.margin>
                                    <Insets left="10"/>
                                </HBox.margin>
                            </Label>
                            <Button fx:id="btnAgregarUbicacion" styleClass="botones" onAction="#agregarUbicacion">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/agregar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets left="30"/>
                                </HBox.margin>
                            </Button>
                            <Label text="Agregar ubicacion" styleClass="labels">
                                <HBox.margin>
                                    <Insets left="10"/>
                                </HBox.margin>
                            </Label>
                            <Button fx:id="btnAgregarUM" styleClass="botones" onAction="#agregarUM">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="18" preserveRatio="true">
                                        <image>
                                            <Image url="@/img/agregar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets left="30"/>
                                </HBox.margin>
                            </Button>
                            <Label text="Agregar unidad de medida" styleClass="labels">
                                <HBox.margin>
                                    <Insets left="10"/>
                                </HBox.margin>
                            </Label>
                        </HBox>
                    </VBox>

                    <!-- TABLAS CON DISTRIBUCIÓN PROPORCIONAL -->
                    <VBox fx:id="contenedorTabla"
                          styleClass="tabla"
                          VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets top="10" bottom="10"/>
                        </padding>

                        <GridPane fx:id="gridTablas"
                                  hgap="20"
                                  vgap="10"
                                  GridPane.hgrow="ALWAYS"
                                  GridPane.vgrow="ALWAYS">

                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" minWidth="200"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" minWidth="200"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" minWidth="200"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" minWidth="200"/>
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints vgrow="ALWAYS" percentHeight="100"/>
                            </rowConstraints>

                            <!-- ===== TABLA MARCAS (PRIMERA) ===== -->
                            <VBox GridPane.columnIndex="0"
                                  spacing="10"
                                  VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets left="40" right="10"/>
                                </padding>

                                <Label text="Marcas"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: center;"
                                       VBox.vgrow="NEVER"/>

                                <TableView fx:id="contenidoTablaMarcas"
                                           styleClass="contenidoTabla"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colSelect"
                                                     prefWidth="60"
                                                     minWidth="60"
                                                     maxWidth="60"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colIDMarca"
                                                     text="id"
                                                     prefWidth="50"
                                                     minWidth="50"
                                                     maxWidth="50"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colNombreMarca"
                                                     text="Nombre"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <!-- ===== TABLA ETIQUETAS ===== -->
                            <VBox GridPane.columnIndex="1"
                                  spacing="10"
                                  VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets left="10" right="10"/>
                                </padding>

                                <Label text="Etiquetas"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: center;"
                                       VBox.vgrow="NEVER"/>

                                <TableView fx:id="contenidoTablaEtiquetas"
                                           styleClass="contenidoTabla"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colSelectEtiqueta"
                                                     prefWidth="60"
                                                     minWidth="60"
                                                     maxWidth="60"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colIDEtiqueta"
                                                     text="id"
                                                     prefWidth="50"
                                                     minWidth="50"
                                                     maxWidth="50"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colNombreEtiqueta"
                                                     text="Nombre"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <!-- ===== TABLA UBICACIONES ===== -->
                            <VBox GridPane.columnIndex="2"
                                  spacing="10"
                                  VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets left="10" right="10"/>
                                </padding>

                                <Label text="Ubicaciones"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: center;"
                                       VBox.vgrow="NEVER"/>

                                <TableView fx:id="contenidoTablaUbicaciones"
                                           styleClass="contenidoTabla"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colSelectUbicaciones"
                                                     prefWidth="60"
                                                     minWidth="60"
                                                     maxWidth="60"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colIDUbicaciones"
                                                     text="id"
                                                     prefWidth="50"
                                                     minWidth="50"
                                                     maxWidth="50"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colNombreUbicaciones"
                                                     text="Nombre"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <!-- ===== TABLA UNIDADES DE MEDIDA (ÚLTIMA) ===== -->
                            <VBox GridPane.columnIndex="3"
                                  spacing="10"
                                  VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets left="10" right="40"/>
                                </padding>

                                <Label text="Unidades de Medida"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: center;"
                                       VBox.vgrow="NEVER"/>

                                <TableView fx:id="contenidoTablaUM"
                                           styleClass="contenidoTabla"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colSelectUM"
                                                     prefWidth="60"
                                                     minWidth="60"
                                                     maxWidth="60"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colIDUM"
                                                     text="id"
                                                     prefWidth="50"
                                                     minWidth="50"
                                                     maxWidth="50"
                                                     resizable="false"/>
                                        <TableColumn fx:id="colNombreUM"
                                                     text="Nombre"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>
            </SplitPane>
        </center>
    </BorderPane>
</StackPane>